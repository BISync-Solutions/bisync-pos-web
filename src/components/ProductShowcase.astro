---
import { ShoppingCart, Boxes, Sparkles, CheckCircle2, ArrowRight } from 'lucide-astro';
import { Image } from 'astro:assets';
import cajaScreen from '../assets/screens/caja.webp';
import inventarioScreen from '../assets/screens/inventario.webp';
---

<section id="capacidades" class="py-20 sm:py-28 relative bg-darkbase-surface/40 border-y border-white/5">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl mx-auto text-center mb-12 sm:mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald/10 border border-emerald/20 text-xs font-semibold text-emerald mb-4">
        <span>Capturas Reales del Software</span>
      </div>
      <h2 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight leading-tight">
        Conoce los dos módulos neurálgicos de tu negocio
      </h2>
      <p class="text-base sm:text-lg text-gray-400 mt-4 leading-relaxed text-balance">
        Explora la interfaz real de BISync POS para la facturación ágil en mostrador y la gestión técnica de inventario con deltas conmutativos.
      </p>

      <!-- Selector de Pestañas Interactivas (Apple HIG Segmented Control) -->
      <div class="inline-flex items-center p-1.5 rounded-2xl bg-darkbase-card border border-white/10 mt-8 shadow-inner" role="tablist" aria-label="Módulos del Sistema">
        <button
          type="button"
          id="tab-btn-caja"
          role="tab"
          aria-selected="true"
          aria-controls="tab-content-caja"
          class="tab-btn active px-6 py-2.5 rounded-xl text-xs sm:text-sm font-bold transition-all duration-200 flex items-center gap-2 text-white bg-cobalt shadow-glow-cobalt"
        >
          <ShoppingCart class="w-4 h-4" />
          <span>Módulo de Caja (Ventas)</span>
        </button>
        <button
          type="button"
          id="tab-btn-inventario"
          role="tab"
          aria-selected="false"
          aria-controls="tab-content-inventario"
          class="tab-btn px-6 py-2.5 rounded-xl text-xs sm:text-sm font-semibold text-gray-400 hover:text-white transition-all duration-200 flex items-center gap-2"
        >
          <Boxes class="w-4 h-4" />
          <span>Inventario & Kardex</span>
        </button>
      </div>
    </div>

    <!-- Contenido de Pestaña 1: Módulo de Caja -->
    <div id="tab-content-caja" class="tab-panel transition-opacity duration-300">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        <!-- Columna Visual de la Captura -->
        <div class="lg:col-span-8">
          <div class="rounded-3xl glass-card overflow-hidden shadow-2xl border border-white/10 ring-1 ring-white/5">
            <div class="px-4 py-3 bg-darkbase-card/90 border-b border-white/5 flex items-center justify-between text-xs text-gray-300">
              <div class="flex items-center gap-2">
                <span class="w-2.5 h-2.5 rounded-full bg-emerald"></span>
                <span class="font-medium text-white">Terminal TERM-01 • Catálogo y Cobro Express</span>
              </div>
              <span class="text-gray-400 text-[11px] font-mono">Tasa oficial en vivo</span>
            </div>
            <div class="relative bg-darkbase">
              <Image
                src={cajaScreen}
                alt="BISync POS — Pantalla Real de Caja y Catálogo de Productos"
                class="w-full h-auto block"
                quality={90}
              />
            </div>
          </div>
        </div>

        <!-- Columna Descriptiva de Funciones -->
        <div class="lg:col-span-4 space-y-6">
          <div class="space-y-3">
            <span class="text-xs font-bold uppercase tracking-wider text-cobalt-light">Agilidad en Mostrador</span>
            <h3 class="text-2xl font-bold text-white">Facturación Inmediata y Multi-Moneda</h3>
            <p class="text-sm text-gray-300 leading-relaxed">
              Diseñado para responder al instante en negocios con alto flujo. El cajero visualiza precios en dólares y moneda local automáticamente convertidos según la tasa oficial configurada.
            </p>
          </div>

          <div class="space-y-3.5 pt-2 border-t border-white/10 text-xs sm:text-sm text-gray-300">
            <div class="flex items-start gap-3">
              <CheckCircle2 class="w-5 h-5 text-emerald flex-shrink-0 mt-0.5" />
              <div>
                <strong class="text-white block font-semibold">Búsqueda Reactiva & Escáner</strong>
                <span class="text-gray-400 text-xs">Lectura de código de barras físico (HID), SKU o búsqueda por texto predictivo.</span>
              </div>
            </div>

            <div class="flex items-start gap-3">
              <CheckCircle2 class="w-5 h-5 text-emerald flex-shrink-0 mt-0.5" />
              <div>
                <strong class="text-white block font-semibold">Cola Local P2P sin Internet</strong>
                <span class="text-gray-400 text-xs">Muestra el estado de ventas en cola local y sincroniza silenciosamente al reconectar.</span>
              </div>
            </div>

            <div class="flex items-start gap-3">
              <CheckCircle2 class="w-5 h-5 text-emerald flex-shrink-0 mt-0.5" />
              <div>
                <strong class="text-white block font-semibold">Unidades Mixtas</strong>
                <span class="text-gray-400 text-xs">Venta fraccionada por litros, kilogramos o paquetes empacados.</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Contenido de Pestaña 2: Control de Inventario & Kardex -->
    <div id="tab-content-inventario" class="tab-panel hidden transition-opacity duration-300">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        <!-- Columna Visual de la Captura -->
        <div class="lg:col-span-8">
          <div class="rounded-3xl glass-card overflow-hidden shadow-2xl border border-white/10 ring-1 ring-white/5">
            <div class="px-4 py-3 bg-darkbase-card/90 border-b border-white/5 flex items-center justify-between text-xs text-gray-300">
              <div class="flex items-center gap-2">
                <span class="w-2.5 h-2.5 rounded-full bg-blue-400"></span>
                <span class="font-medium text-white">Control de Inventario y Kardex • Valorización de Stock</span>
              </div>
              <span class="text-gray-400 text-[11px] font-mono">Deltas conmutativos CRDT</span>
            </div>
            <div class="relative bg-darkbase">
              <Image
                src={inventarioScreen}
                alt="BISync POS — Pantalla Real de Control de Inventario y Kardex"
                class="w-full h-auto block"
                quality={90}
              />
            </div>
          </div>
        </div>

        <!-- Columna Descriptiva de Funciones -->
        <div class="lg:col-span-4 space-y-6">
          <div class="space-y-3">
            <span class="text-xs font-bold uppercase tracking-wider text-emerald">Matemática Local-First</span>
            <h3 class="text-2xl font-bold text-white">Stock Blindado con Deltas Conmutativos</h3>
            <p class="text-sm text-gray-300 leading-relaxed">
              Adiós a los bloqueos de base de datos o sobre-escrituras accidentales. Las modificaciones de inventario se procesan como operaciones matemáticas conmutativas que convergen perfectamente entre terminales.
            </p>
          </div>

          <div class="space-y-3.5 pt-2 border-t border-white/10 text-xs sm:text-sm text-gray-300">
            <div class="flex items-start gap-3">
              <CheckCircle2 class="w-5 h-5 text-emerald flex-shrink-0 mt-0.5" />
              <div>
                <strong class="text-white block font-semibold">Valor Costo vs. Valor Venta</strong>
                <span class="text-gray-400 text-xs">Métricas en vivo de tu capital invertido y proyección de ingresos brutos.</span>
              </div>
            </div>

            <div class="flex items-start gap-3">
              <CheckCircle2 class="w-5 h-5 text-emerald flex-shrink-0 mt-0.5" />
              <div>
                <strong class="text-white block font-semibold">Alertas de Stock Bajo</strong>
                <span class="text-gray-400 text-xs">Indicadores amarillos inmediatos para reposición oportuna de mercadería crítica.</span>
              </div>
            </div>

            <div class="flex items-start gap-3">
              <CheckCircle2 class="w-5 h-5 text-emerald flex-shrink-0 mt-0.5" />
              <div>
                <strong class="text-white block font-semibold">Ajustes Rápidos de Stock</strong>
                <span class="text-gray-400 text-xs">Botón directo de ajuste por mermas, entradas de proveedor o conteo físico.</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const btnCaja = document.getElementById('tab-btn-caja');
  const btnInventario = document.getElementById('tab-btn-inventario');
  const panelCaja = document.getElementById('tab-content-caja');
  const panelInventario = document.getElementById('tab-content-inventario');

  function showCaja() {
    btnCaja?.classList.add('bg-cobalt', 'text-white', 'shadow-glow-cobalt');
    btnCaja?.classList.remove('text-gray-400');
    btnCaja?.setAttribute('aria-selected', 'true');

    btnInventario?.classList.remove('bg-cobalt', 'text-white', 'shadow-glow-cobalt');
    btnInventario?.classList.add('text-gray-400');
    btnInventario?.setAttribute('aria-selected', 'false');

    panelCaja?.classList.remove('hidden');
    panelInventario?.classList.add('hidden');
  }

  function showInventario() {
    btnInventario?.classList.add('bg-cobalt', 'text-white', 'shadow-glow-cobalt');
    btnInventario?.classList.remove('text-gray-400');
    btnInventario?.setAttribute('aria-selected', 'true');

    btnCaja?.classList.remove('bg-cobalt', 'text-white', 'shadow-glow-cobalt');
    btnCaja?.classList.add('text-gray-400');
    btnCaja?.setAttribute('aria-selected', 'false');

    panelInventario?.classList.remove('hidden');
    panelCaja?.classList.add('hidden');
  }

  btnCaja?.addEventListener('click', showCaja);
  btnInventario?.addEventListener('click', showInventario);
</script>
