---
import { Send, CheckCircle2, AlertCircle, Sparkles, Shield, Clock } from 'lucide-astro';

// URL del Webhook de Google Apps Script:
const GOOGLE_SCRIPT_WEBHOOK_URL = "https://script.google.com/macros/s/AKfycbxg98x82iq-Ih9vZPJE9BCW-gIRnGCl9ytPM0JgZz6Ld-LPfGKo6fASU8r_w2CuIZ3aUg/exec";
---

<section id="contacto" class="py-20 sm:py-28 relative overflow-hidden">
  <!-- Glows decorativos de fondo -->
  <div class="absolute inset-0 bg-gradient-to-b from-transparent via-cobalt/5 to-transparent pointer-events-none"></div>
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[650px] h-[350px] bg-cobalt/10 rounded-full blur-[140px] pointer-events-none"></div>

  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 relative">
    <div class="text-center mb-12 sm:mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cobalt/10 border border-cobalt/20 text-xs font-semibold text-cobalt-light mb-4">
        <Sparkles class="w-3.5 h-3.5" />
        <span>Atención Personalizada</span>
      </div>
      <h2 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight leading-tight">
        Solicita tu Licencia o Contáctanos
      </h2>
      <p class="text-base sm:text-lg text-gray-400 mt-4 leading-relaxed max-w-2xl mx-auto text-balance">
        Déjanos tus datos de contacto y el plan de tu interés. Te responderemos personalmente con la cotización y activación de tu licencia anual.
      </p>
    </div>

    <!-- Contenedor del Formulario -->
    <div class="glass-card rounded-3xl border border-white/10 p-6 sm:p-12 relative shadow-2xl backdrop-blur-xl">
      <!-- Formulario Activo -->
      <form id="contact-lead-form" class="space-y-6" novalidate data-webhook={GOOGLE_SCRIPT_WEBHOOK_URL}>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          <!-- Nombre Completo -->
          <div>
            <label for="lead-name" class="block text-xs font-semibold uppercase tracking-wider text-gray-300 mb-2">
              Nombre y Apellido <span class="text-emerald">*</span>
            </label>
            <input
              type="text"
              id="lead-name"
              name="name"
              required
              autocomplete="name"
              placeholder="Ej. Carlos Mendoza"
              class="w-full px-4 py-3.5 rounded-xl bg-darkbase-surface/80 border border-white/10 text-white placeholder-gray-500 text-sm focus:outline-none focus:border-cobalt focus:ring-1 focus:ring-cobalt transition-colors"
            />
          </div>

          <!-- Correo Electrónico -->
          <div>
            <label for="lead-email" class="block text-xs font-semibold uppercase tracking-wider text-gray-300 mb-2">
              Correo Electrónico <span class="text-emerald">*</span>
            </label>
            <input
              type="email"
              id="lead-email"
              name="email"
              required
              autocomplete="email"
              placeholder="ejemplo@negocio.com"
              class="w-full px-4 py-3.5 rounded-xl bg-darkbase-surface/80 border border-white/10 text-white placeholder-gray-500 text-sm focus:outline-none focus:border-cobalt focus:ring-1 focus:ring-cobalt transition-colors"
            />
          </div>

          <!-- Teléfono / WhatsApp -->
          <div>
            <label for="lead-phone" class="block text-xs font-semibold uppercase tracking-wider text-gray-300 mb-2">
              WhatsApp / Teléfono <span class="text-emerald">*</span>
            </label>
            <input
              type="tel"
              id="lead-phone"
              name="phone"
              required
              autocomplete="tel"
              placeholder="Ej. +58 412 1234567"
              class="w-full px-4 py-3.5 rounded-xl bg-darkbase-surface/80 border border-white/10 text-white placeholder-gray-500 text-sm focus:outline-none focus:border-cobalt focus:ring-1 focus:ring-cobalt transition-colors"
            />
          </div>

          <!-- Nombre del Negocio / Rubro -->
          <div>
            <label for="lead-business" class="block text-xs font-semibold uppercase tracking-wider text-gray-300 mb-2">
              Nombre de tu Negocio / Comercio
            </label>
            <input
              type="text"
              id="lead-business"
              name="business"
              autocomplete="organization"
              placeholder="Ej. Minimarket La Estrella"
              class="w-full px-4 py-3.5 rounded-xl bg-darkbase-surface/80 border border-white/10 text-white placeholder-gray-500 text-sm focus:outline-none focus:border-cobalt focus:ring-1 focus:ring-cobalt transition-colors"
            />
          </div>
        </div>

        <!-- Plan de Interés -->
        <div>
          <label for="lead-plan" class="block text-xs font-semibold uppercase tracking-wider text-gray-300 mb-2">
            Plan o Tipo de Consulta <span class="text-emerald">*</span>
          </label>
          <div class="relative">
            <select
              id="lead-plan"
              name="plan"
              required
              class="w-full px-4 py-3.5 rounded-xl bg-darkbase-surface/80 border border-white/10 text-white text-sm focus:outline-none focus:border-cobalt focus:ring-1 focus:ring-cobalt transition-colors appearance-none cursor-pointer"
            >
              <option value="Comercio Pro (Licencia Anual $348/año)" class="bg-darkbase text-white">
                Comercio Pro — Licencia Anual ($29/mes · $348/año por caja)
              </option>
              <option value="Multi-Sucursal (Múltiples Cajas / Tiendas)" class="bg-darkbase text-white">
                Multi-Sucursal — 2 o más cajas / Varias tiendas
              </option>
              <option value="Duda o Consulta General" class="bg-darkbase text-white">
                Duda técnica / Consulta de compatibilidad de periféricos
              </option>
            </select>
            <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-4 text-gray-400">
              <svg class="h-4 w-4 fill-current" viewBox="0 0 20 20">
                <path d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z"/>
              </svg>
            </div>
          </div>
        </div>

        <!-- Mensaje / Detalles adicionales -->
        <div>
          <label for="lead-message" class="block text-xs font-semibold uppercase tracking-wider text-gray-300 mb-2">
            Mensaje o Pregunta Específica (Opcional)
          </label>
          <textarea
            id="lead-message"
            name="message"
            rows="3"
            placeholder="Indícanos cuántas cajas utilizas, tu modelo de impresora o cualquier duda..."
            class="w-full px-4 py-3.5 rounded-xl bg-darkbase-surface/80 border border-white/10 text-white placeholder-gray-500 text-sm focus:outline-none focus:border-cobalt focus:ring-1 focus:ring-cobalt transition-colors resize-none"
          ></textarea>
        </div>

        <!-- Mensaje de Error en Validación/Envío -->
        <div id="form-error-alert" class="hidden p-4 rounded-xl bg-red-500/10 border border-red-500/30 text-red-300 text-sm flex items-start gap-3">
          <AlertCircle class="w-5 h-5 flex-shrink-0 text-red-400 mt-0.5" />
          <div id="form-error-text">Por favor completa todos los campos obligatorios.</div>
        </div>

        <!-- Botón de Envío -->
        <div class="pt-2">
          <button
            type="submit"
            id="submit-lead-btn"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-8 py-4 rounded-xl text-sm sm:text-base font-bold text-white bg-cobalt hover:bg-cobalt-hover active:scale-[0.98] transition-all shadow-glow-cobalt focus-visible:ring-2 focus-visible:ring-cobalt disabled:opacity-50 disabled:cursor-not-allowed"
          >
            <Send class="w-4 h-4" id="btn-send-icon" />
            <svg id="btn-spinner" class="animate-spin w-4 h-4 hidden text-white" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
            <span id="btn-text">Enviar Solicitud</span>
          </button>
        </div>

        <!-- Garantías de Privacidad -->
        <div class="pt-4 border-t border-white/5 flex flex-wrap items-center justify-between gap-4 text-xs text-gray-400">
          <div class="flex items-center gap-2">
            <Shield class="w-4 h-4 text-emerald" />
            <span>Tus datos son 100% confidenciales. Cero spam.</span>
          </div>
          <div class="flex items-center gap-2">
            <Clock class="w-4 h-4 text-cobalt-light" />
            <span>Respuesta directa y personalizada</span>
          </div>
        </div>
      </form>

      <!-- Mensaje de Éxito (se muestra al enviar) -->
      <div id="form-success-card" class="hidden text-center py-12 px-4 space-y-4">
        <div class="w-16 h-16 rounded-full bg-emerald/10 border border-emerald/30 text-emerald flex items-center justify-center mx-auto shadow-glow-emerald">
          <CheckCircle2 class="w-8 h-8" />
        </div>
        <h3 class="text-2xl font-bold text-white">¡Solicitud Enviada con Éxito!</h3>
        <p class="text-sm sm:text-base text-gray-300 max-w-md mx-auto leading-relaxed">
          Hemos recibido tus datos correctamente en nuestra hoja de control. Te contactaremos personalmente al correo o WhatsApp indicado para coordinar la activación de tu licencia.
        </p>
        <div class="pt-4">
          <button
            type="button"
            id="reset-form-btn"
            class="inline-flex items-center justify-center px-6 py-2.5 rounded-xl text-xs font-semibold text-gray-300 bg-white/10 hover:bg-white/15 transition-colors"
          >
            Enviar otra consulta
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  function setupContactForm() {
    const form = document.getElementById('contact-lead-form') as HTMLFormElement | null;
    const successCard = document.getElementById('form-success-card');
    const submitBtn = document.getElementById('submit-lead-btn') as HTMLButtonElement | null;
    const btnText = document.getElementById('btn-text');
    const btnIcon = document.getElementById('btn-send-icon');
    const btnSpinner = document.getElementById('btn-spinner');
    const errorAlert = document.getElementById('form-error-alert');
    const errorText = document.getElementById('form-error-text');
    const resetBtn = document.getElementById('reset-form-btn');

    if (!form || !successCard || !submitBtn || !btnText || !btnIcon || !btnSpinner || !errorAlert || !errorText) {
      return;
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorAlert.classList.add('hidden');

      const name = (form.querySelector('#lead-name') as HTMLInputElement)?.value.trim();
      const email = (form.querySelector('#lead-email') as HTMLInputElement)?.value.trim();
      const phone = (form.querySelector('#lead-phone') as HTMLInputElement)?.value.trim();
      const business = (form.querySelector('#lead-business') as HTMLInputElement)?.value.trim() || 'No especificado';
      const plan = (form.querySelector('#lead-plan') as HTMLSelectElement)?.value;
      const message = (form.querySelector('#lead-message') as HTMLTextAreaElement)?.value.trim() || 'Sin comentarios adicionales';

      // Validación simple
      if (!name || !email || !phone) {
        errorText.textContent = 'Por favor completa tu nombre, correo electrónico y número de WhatsApp.';
        errorAlert.classList.remove('hidden');
        return;
      }

      const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
      if (!emailRegex.test(email)) {
        errorText.textContent = 'Por favor introduce una dirección de correo electrónico válida.';
        errorAlert.classList.remove('hidden');
        return;
      }

      // Estado de carga
      submitBtn.disabled = true;
      btnSpinner.classList.remove('hidden');
      btnIcon.classList.add('hidden');
      btnText.textContent = 'Enviando...';

      const webhookUrl = form.dataset.webhook?.trim();

      const payload = {
        name,
        email,
        phone,
        business,
        plan,
        message,
        source: 'bisync-pos-web',
        timestamp: new Date().toISOString()
      };

      try {
        if (webhookUrl && webhookUrl.startsWith('http')) {
          // Envío a Google Apps Script Web App
          // Se usa text/plain y no-cors para evitar problemas de CORS preflight de Google
          await fetch(webhookUrl, {
            method: 'POST',
            mode: 'no-cors',
            headers: {
              'Content-Type': 'text/plain;charset=utf-8'
            },
            body: JSON.stringify(payload)
          });
        } else {
          // Si el webhook aún no está configurado, simulamos envío exitoso para testing
          console.warn('Webhook no configurado en data-webhook. Modo de prueba activo.', payload);
          await new Promise((resolve) => setTimeout(resolve, 800));
        }

        // Mostrar pantalla de éxito
        form.classList.add('hidden');
        successCard.classList.remove('hidden');
        form.reset();
      } catch (err) {
        console.error('Error enviando formulario:', err);
        errorText.textContent = 'Hubo un inconveniente al enviar tus datos. Por favor inténtalo de nuevo o contáctanos por WhatsApp.';
        errorAlert.classList.remove('hidden');
      } finally {
        submitBtn.disabled = false;
        btnSpinner.classList.add('hidden');
        btnIcon.classList.remove('hidden');
        btnText.textContent = 'Enviar Solicitud';
      }
    });

    resetBtn?.addEventListener('click', () => {
      successCard.classList.add('hidden');
      form.classList.remove('hidden');
    });
  }

  // Ejecutar en carga inicial y en transiciones de vista de Astro
  setupContactForm();
  document.addEventListener('astro:page-load', setupContactForm);
</script>
