---
import { Check, Download, Sparkles } from 'lucide-astro';

const downloadUrl = "https://github.com/erick83/bisync-pos-web/releases/latest/download/Bisync_POS_setup.exe";
---

<section id="planes" class="py-20 sm:py-28 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl mx-auto text-center mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cobalt/10 border border-cobalt/20 text-xs font-semibold text-cobalt-light mb-4">
        <span>Transparencia Total</span>
      </div>
      <h2 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight leading-tight">
        Planes claros para comercios de cualquier tamaño
      </h2>
      <p class="text-base sm:text-lg text-gray-400 mt-4 leading-relaxed text-balance">
        Comienza gratis con el instalador oficial y elige el plan que mejor se adapte al crecimiento de tus cajas.
      </p>
    </div>

    <!-- Grid de Planes -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-6xl mx-auto items-stretch">
      <!-- Plan 1: Evaluación / Starter -->
      <div class="rounded-3xl glass-card p-8 border-white/10 flex flex-col justify-between">
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-gray-400">Prueba Gratuita</span>
          <h3 class="text-2xl font-bold text-white mt-1 mb-2">Comunidad</h3>
          <p class="text-xs text-gray-400 mb-6">Ideal para probar el sistema y evaluar la velocidad en tu caja registradora.</p>

          <div class="flex items-baseline gap-1 mb-6">
            <span class="text-4xl font-extrabold text-white">$0</span>
            <span class="text-xs text-gray-400 font-medium">/ 30 días de prueba</span>
          </div>

          <ul class="space-y-3 text-xs sm:text-sm text-gray-300">
            <li class="flex items-center gap-2.5">
              <Check class="w-4 h-4 text-emerald flex-shrink-0" />
              <span>1 Terminal de Punto de Venta</span>
            </li>
            <li class="flex items-center gap-2.5">
              <Check class="w-4 h-4 text-emerald flex-shrink-0" />
              <span>Facturación offline ilimitada</span>
            </li>
            <li class="flex items-center gap-2.5">
              <Check class="w-4 h-4 text-emerald flex-shrink-0" />
              <span>Catálogo hasta 500 productos</span>
            </li>
            <li class="flex items-center gap-2.5">
              <Check class="w-4 h-4 text-emerald flex-shrink-0" />
              <span>Impresión térmica básica 58mm/80mm</span>
            </li>
          </ul>
        </div>

        <div class="mt-8 pt-6 border-t border-white/5">
          <a
            href={downloadUrl}
            class="w-full inline-flex items-center justify-center gap-2 py-3 px-4 rounded-xl text-sm font-semibold text-white bg-white/10 hover:bg-white/15 transition-colors focus-visible:ring-2 focus-visible:ring-cobalt"
          >
            <Download class="w-4 h-4" />
            <span>Descargar Gratis</span>
          </a>
        </div>
      </div>

      <!-- Plan 2: Pro Negocio (Destacado) -->
      <div class="rounded-3xl glass-card p-8 border-cobalt/50 relative flex flex-col justify-between shadow-glow-cobalt bg-darkbase-card/90 md:-translate-y-2">
        <div class="absolute -top-3.5 left-1/2 -translate-x-1/2 px-3.5 py-1 rounded-full bg-cobalt text-white text-[11px] font-bold tracking-wider uppercase flex items-center gap-1 shadow-md">
          <Sparkles class="w-3.5 h-3.5" />
          <span>Más Popular</span>
        </div>

        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-cobalt-light">Comercio Activo</span>
          <h3 class="text-2xl font-bold text-white mt-1 mb-2">Comercio Pro</h3>
          <p class="text-xs text-gray-400 mb-6">Para tiendas, minimarkets y farmacias que no pueden detenerse ni un minuto.</p>

          <div class="flex items-baseline gap-1 mb-6">
            <span class="text-4xl font-extrabold text-white">$29</span>
            <span class="text-xs text-gray-400 font-medium">/ mes por caja</span>
          </div>

          <ul class="space-y-3 text-xs sm:text-sm text-gray-200">
            <li class="flex items-center gap-2.5">
              <Check class="w-4 h-4 text-emerald flex-shrink-0" />
              <span>Productos y clientes ilimitados</span>
            </li>
            <li class="flex items-center gap-2.5">
              <Check class="w-4 h-4 text-emerald flex-shrink-0" />
              <span>Respaldo y sincronización en la nube</span>
            </li>
            <li class="flex items-center gap-2.5">
              <Check class="w-4 h-4 text-emerald flex-shrink-0" />
              <span>Cortes Z y X con auditoría ciega</span>
            </li>
            <li class="flex items-center gap-2.5">
              <Check class="w-4 h-4 text-emerald flex-shrink-0" />
              <span>Soporte técnico prioritario</span>
            </li>
            <li class="flex items-center gap-2.5">
              <Check class="w-4 h-4 text-emerald flex-shrink-0" />
              <span>Control de turnos y permisos por cajero</span>
            </li>
          </ul>
        </div>

        <div class="mt-8 pt-6 border-t border-white/5">
          <a
            href={downloadUrl}
            class="w-full inline-flex items-center justify-center gap-2 py-3 px-4 rounded-xl text-sm font-bold text-white bg-cobalt hover:bg-cobalt-hover active:scale-[0.98] transition-all shadow-md focus-visible:ring-2 focus-visible:ring-cobalt"
          >
            <Download class="w-4 h-4" />
            <span>Instalar y Activar Pro</span>
          </a>
        </div>
      </div>

      <!-- Plan 3: Red de Sucursales / Multi-tienda -->
      <div class="rounded-3xl glass-card p-8 border-white/10 flex flex-col justify-between">
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-gray-400">Crecimiento</span>
          <h3 class="text-2xl font-bold text-white mt-1 mb-2">Multi-Sucursal</h3>
          <p class="text-xs text-gray-400 mb-6">Control consolidado para cadenas con múltiples tiendas o almacenes.</p>

          <div class="flex items-baseline gap-1 mb-6">
            <span class="text-4xl font-extrabold text-white">Personalizado</span>
          </div>

          <ul class="space-y-3 text-xs sm:text-sm text-gray-300">
            <li class="flex items-center gap-2.5">
              <Check class="w-4 h-4 text-emerald flex-shrink-0" />
              <span>Consolidación de ventas multi-tienda</span>
            </li>
            <li class="flex items-center gap-2.5">
              <Check class="w-4 h-4 text-emerald flex-shrink-0" />
              <span>Transferencias de stock entre sucursales</span>
            </li>
            <li class="flex items-center gap-2.5">
              <Check class="w-4 h-4 text-emerald flex-shrink-0" />
              <span>Capacitación remota a cajeros</span>
            </li>
            <li class="flex items-center gap-2.5">
              <Check class="w-4 h-4 text-emerald flex-shrink-0" />
              <span>Acuerdo de nivel de servicio (SLA 99.9%)</span>
            </li>
          </ul>
        </div>

        <div class="mt-8 pt-6 border-t border-white/5">
          <a
            href="mailto:ventas@bisync.com?subject=Consulta%20Plan%20Multi-Sucursal"
            class="w-full inline-flex items-center justify-center gap-2 py-3 px-4 rounded-xl text-sm font-semibold text-gray-200 bg-white/10 hover:bg-white/15 transition-colors focus-visible:ring-2 focus-visible:ring-cobalt"
          >
            <span>Contactar Asesor</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
