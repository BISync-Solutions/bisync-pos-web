---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import Features from '../components/Features.astro';
import ProductShowcase from '../components/ProductShowcase.astro';
import Pricing from '../components/Pricing.astro';
import DownloadCTA from '../components/DownloadCTA.astro';
import FAQ from '../components/FAQ.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="BISync POS — Sistema de Punto de Venta Inteligente y Robusto"
  description="El sistema de Punto de Venta más rápido, robusto y confiable para Windows. Facturación ágil, inventario en tiempo real y operación continua sin internet."
>
  <Navbar slot="header" />

  <Hero />
  <Features />
  <ProductShowcase />
  <Pricing />
  <DownloadCTA />
  <FAQ />

  <Footer slot="footer" />
</BaseLayout>
