---
import { Download, ArrowRight, ShieldCheck, Zap, WifiOff, CheckCircle2 } from 'lucide-astro';

const downloadUrl = "https://github.com/erick83/bisync-pos-web/releases/latest/download/Bisync_POS_setup.exe";
---

<section class="relative pt-12 pb-20 sm:pt-20 sm:pb-28 overflow-hidden">
  <!-- Luces de fondo difuminadas (Glows atmosféricos de marca) -->
  <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[350px] bg-cobalt/15 rounded-full blur-[130px] -z-10 pointer-events-none"></div>
  <div class="absolute top-1/3 left-1/4 -translate-x-1/2 w-[350px] h-[250px] bg-emerald/10 rounded-full blur-[110px] -z-10 pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col items-center text-center max-w-4xl mx-auto">
      <!-- Badge de Estado -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/[0.04] border border-white/10 text-xs font-semibold text-gray-300 mb-8 backdrop-blur-md hover:border-cobalt/40 transition-colors">
        <span class="inline-block w-2 h-2 rounded-full bg-emerald animate-pulse" aria-hidden="true"></span>
        <span>Versión Oficial 2.0 para Windows disponible</span>
        <span class="text-gray-500">•</span>
        <span class="text-cobalt-light font-medium">64-bit</span>
      </div>

      <!-- H1 Único y Jerarquía Tipográfica Apple HIG -->
      <h1 class="text-4xl sm:text-6xl lg:text-7xl font-extrabold tracking-tight text-white leading-[1.08] text-balance mb-6">
        El Punto de Venta <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 via-cobalt to-emerald">rápido y confiable</span> que tu negocio necesita.
      </h1>

      <!-- Párrafo Descriptivo -->
      <p class="text-lg sm:text-xl text-gray-300 max-w-2xl leading-relaxed text-balance mb-10 font-normal">
        Factura en segundos, controla tu inventario al instante y continúa vendiendo sin interrupciones con sincronización continua y arquitectura offline-first.
      </p>

      <!-- Grupo de Acciones Principales (CTAs) -->
      <div class="flex flex-col sm:flex-row items-center gap-4 w-full sm:w-auto mb-12">
        <!-- CTA Principal: Descarga Esmeralda Oficial -->
        <a
          href={downloadUrl}
          class="w-full sm:w-auto inline-flex items-center justify-center gap-3 px-8 py-4 rounded-2xl font-bold text-base text-white bg-emerald hover:bg-emerald-hover active:scale-[0.98] transition-all duration-200 shadow-glow-emerald border border-emerald-light/20 focus-visible:ring-2 focus-visible:ring-emerald focus-visible:ring-offset-4 focus-visible:ring-offset-darkbase"
          id="hero-download-btn"
        >
          <!-- Icono Windows SVG -->
          <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M0 3.449L9.75 2.1v9.451H0V3.449zm10.949-1.564L24 0v11.551H10.949V1.885zM0 12.6h9.75v9.451L0 20.699V12.6zm10.949 0H24V24l-13.051-1.836V12.6z"/>
          </svg>
          <div class="flex flex-col text-left leading-tight">
            <span>Descargar para Windows</span>
            <span class="text-[11px] font-normal text-white/80">Instalador oficial .exe (v2.0)</span>
          </div>
          <Download class="w-5 h-5 ml-1" />
        </a>

        <!-- CTA Secundario: Explorar Funciones -->
        <a
          href="#caracteristicas"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-7 py-4 rounded-2xl font-semibold text-base text-gray-200 glass-card hover:bg-white/10 active:scale-[0.98] transition-all duration-200 focus-visible:ring-2 focus-visible:ring-cobalt"
        >
          <span>Conocer funciones</span>
          <ArrowRight class="w-4 h-4 text-cobalt-light" />
        </a>
      </div>

      <!-- Métricas / Indicadores Rápidos de Confianza -->
      <div class="flex flex-wrap items-center justify-center gap-y-3 gap-x-8 text-xs sm:text-sm text-gray-400">
        <div class="flex items-center gap-2">
          <CheckCircle2 class="w-4 h-4 text-emerald" />
          <span>100% Funcional sin Internet</span>
        </div>
        <div class="flex items-center gap-2">
          <CheckCircle2 class="w-4 h-4 text-emerald" />
          <span>Impresión Térmica ESC/POS</span>
        </div>
        <div class="flex items-center gap-2">
          <CheckCircle2 class="w-4 h-4 text-emerald" />
          <span>Sin contratos forzosos</span>
        </div>
      </div>
    </div>

    <!-- Mockup de Interfaz Placeholder en Estilo Apple HIG Window -->
    <div class="mt-14 sm:mt-20 relative max-w-5xl mx-auto">
      <div class="rounded-3xl glass-card overflow-hidden shadow-2xl border border-white/10 ring-1 ring-white/5">
        <!-- Barra de Ventana Superior (Apple HIG inspired window header) -->
        <div class="flex items-center justify-between px-4 py-3 bg-darkbase-card/80 border-b border-white/5 select-none">
          <div class="flex items-center gap-2">
            <span class="w-3 h-3 rounded-full bg-red-500/80 inline-block"></span>
            <span class="w-3 h-3 rounded-full bg-yellow-500/80 inline-block"></span>
            <span class="w-3 h-3 rounded-full bg-green-500/80 inline-block"></span>
          </div>
          <div class="text-xs font-medium text-gray-400 flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-emerald"></span>
            <span>BISync POS v2.0 — Modo Caja: Terminal 01 (En Línea & Sincronizado)</span>
          </div>
          <div class="text-xs text-gray-500 font-mono">1280 × 800</div>
        </div>

        <!-- Cuerpo del Mockup Placeholder del POS -->
        <div class="p-4 sm:p-6 bg-darkbase/90 grid grid-cols-1 lg:grid-cols-12 gap-6 min-h-[440px]">
          <!-- Panel Izquierdo: Catálogo y Búsqueda de Productos -->
          <div class="lg:col-span-8 flex flex-col gap-4">
            <!-- Barra de búsqueda rápida de caja -->
            <div class="flex items-center gap-3 p-3 rounded-xl bg-darkbase-surface border border-white/5 text-sm text-gray-300">
              <svg class="w-5 h-5 text-cobalt" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
              <span class="text-gray-400">Escanea código de barras [F2] o escribe el producto...</span>
              <span class="ml-auto text-xs px-2 py-0.5 rounded bg-white/5 text-gray-400 border border-white/10 font-mono">F2</span>
            </div>

            <!-- Categorías rápidas -->
            <div class="flex items-center gap-2 overflow-x-auto pb-1 text-xs">
              <span class="px-3 py-1.5 rounded-lg bg-cobalt text-white font-medium cursor-default">Todos</span>
              <span class="px-3 py-1.5 rounded-lg bg-darkbase-card text-gray-300 border border-white/5 cursor-default">Bebidas</span>
              <span class="px-3 py-1.5 rounded-lg bg-darkbase-card text-gray-300 border border-white/5 cursor-default">Abarrotes</span>
              <span class="px-3 py-1.5 rounded-lg bg-darkbase-card text-gray-300 border border-white/5 cursor-default">Snacks</span>
              <span class="px-3 py-1.5 rounded-lg bg-darkbase-card text-gray-300 border border-white/5 cursor-default">Limpieza</span>
            </div>

            <!-- Grid de productos de demostración -->
            <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 flex-grow">
              <div class="p-3.5 rounded-xl bg-darkbase-card border border-white/5 hover:border-cobalt/40 transition-colors flex flex-col justify-between">
                <div>
                  <div class="w-full h-20 rounded-lg bg-white/5 flex items-center justify-center mb-2.5 text-gray-500 text-xs">
                    [ Imagen Producto ]
                  </div>
                  <h4 class="font-medium text-sm text-white">Café Grano 500g</h4>
                  <p class="text-xs text-gray-400 mt-0.5">SKU: 75010293</p>
                </div>
                <div class="flex items-center justify-between mt-3 pt-2 border-t border-white/5">
                  <span class="text-emerald font-bold text-sm">$8.50</span>
                  <span class="text-[10px] text-gray-400 bg-emerald/10 text-emerald px-1.5 py-0.5 rounded">Stock 24</span>
                </div>
              </div>

              <div class="p-3.5 rounded-xl bg-darkbase-card border border-white/5 hover:border-cobalt/40 transition-colors flex flex-col justify-between">
                <div>
                  <div class="w-full h-20 rounded-lg bg-white/5 flex items-center justify-center mb-2.5 text-gray-500 text-xs">
                    [ Imagen Producto ]
                  </div>
                  <h4 class="font-medium text-sm text-white">Bebida Refrescante 1L</h4>
                  <p class="text-xs text-gray-400 mt-0.5">SKU: 75020119</p>
                </div>
                <div class="flex items-center justify-between mt-3 pt-2 border-t border-white/5">
                  <span class="text-emerald font-bold text-sm">$2.20</span>
                  <span class="text-[10px] text-gray-400 bg-emerald/10 text-emerald px-1.5 py-0.5 rounded">Stock 68</span>
                </div>
              </div>

              <div class="p-3.5 rounded-xl bg-darkbase-card border border-white/5 hover:border-cobalt/40 transition-colors flex flex-col justify-between">
                <div>
                  <div class="w-full h-20 rounded-lg bg-white/5 flex items-center justify-center mb-2.5 text-gray-500 text-xs">
                    [ Imagen Producto ]
                  </div>
                  <h4 class="font-medium text-sm text-white">Galletas Avena & Miel</h4>
                  <p class="text-xs text-gray-400 mt-0.5">SKU: 75039401</p>
                </div>
                <div class="flex items-center justify-between mt-3 pt-2 border-t border-white/5">
                  <span class="text-emerald font-bold text-sm">$1.75</span>
                  <span class="text-[10px] text-gray-400 bg-emerald/10 text-emerald px-1.5 py-0.5 rounded">Stock 15</span>
                </div>
              </div>
            </div>
          </div>

          <!-- Panel Derecho: Ticket de Venta en Curso y Cobro -->
          <div class="lg:col-span-4 rounded-2xl bg-darkbase-surface p-4 border border-white/5 flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between pb-3 border-b border-white/5 text-xs text-gray-300">
                <span class="font-semibold text-white">Ticket #1042</span>
                <span class="text-gray-400">Cliente General</span>
              </div>

              <!-- Lista de ítems en el carrito -->
              <div class="space-y-3 py-3 text-xs">
                <div class="flex items-center justify-between">
                  <div>
                    <p class="font-medium text-white">Café Grano 500g</p>
                    <p class="text-gray-400">2 × $8.50</p>
                  </div>
                  <span class="font-semibold text-white">$17.00</span>
                </div>

                <div class="flex items-center justify-between">
                  <div>
                    <p class="font-medium text-white">Bebida Refrescante 1L</p>
                    <p class="text-gray-400">1 × $2.20</p>
                  </div>
                  <span class="font-semibold text-white">$2.20</span>
                </div>
              </div>
            </div>

            <!-- Resumen y Botón de Cobro Rápido -->
            <div class="pt-4 border-t border-white/5 space-y-3">
              <div class="flex justify-between text-xs text-gray-400">
                <span>Subtotal</span>
                <span>$19.20</span>
              </div>
              <div class="flex justify-between text-xs text-gray-400">
                <span>Impuesto (16%)</span>
                <span>$3.07</span>
              </div>
              <div class="flex justify-between text-base font-extrabold text-white pt-2 border-t border-white/5">
                <span>Total a Cobrar</span>
                <span class="text-emerald text-lg">$22.27</span>
              </div>

              <div class="grid grid-cols-2 gap-2 pt-2">
                <button type="button" class="py-2.5 px-3 rounded-xl bg-cobalt hover:bg-cobalt-hover text-white text-xs font-bold transition-colors">
                  Efectivo [F5]
                </button>
                <button type="button" class="py-2.5 px-3 rounded-xl bg-white/10 hover:bg-white/15 text-white text-xs font-bold transition-colors">
                  Tarjeta [F6]
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
